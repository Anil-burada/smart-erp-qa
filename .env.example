# Copy to .env for application settings. The one-click Leocem script uses its own login() values; do not fill DMG passwords here. DO NOT commit .env.
# Account aliases in approval_plans/kagami_ba/indent_to_grn.json:
ERPQA_KAGAMI_BA_CREATOR_USERNAME=
ERPQA_KAGAMI_BA_CREATOR_PASSWORD=
ERPQA_KAGAMI_BA_MANAGER_USERNAME=
ERPQA_KAGAMI_BA_MANAGER_PASSWORD=
ERPQA_KAGAMI_BA_INDENT_FINAL_USERNAME=
ERPQA_KAGAMI_BA_INDENT_FINAL_PASSWORD=
ERPQA_KAGAMI_BA_PO_FINAL_USERNAME=
ERPQA_KAGAMI_BA_PO_FINAL_PASSWORD=
# For every additional ERP, use ERPQA_<PROJECT_ID>_<ACCOUNT_ALIAS>_USERNAME/PASSWORD
# The v6.3.2 Leocem one-click script uses its own login() code; no role passwords are required here.
# Harmless local demo credentials. The mock accepts any NON-EMPTY values.
ERPQA_MOCK_ERP_CREATOR_USERNAME=demo_creator
ERPQA_MOCK_ERP_CREATOR_PASSWORD=demo_only_1
ERPQA_MOCK_ERP_MANAGER_USERNAME=demo_manager
ERPQA_MOCK_ERP_MANAGER_PASSWORD=demo_only_2
ERPQA_MOCK_ERP_BUYER_USERNAME=demo_buyer
ERPQA_MOCK_ERP_BUYER_PASSWORD=demo_only_3
ERPQA_MOCK_ERP_GM_USERNAME=demo_gm
ERPQA_MOCK_ERP_GM_PASSWORD=demo_only_4
ERPQA_MOCK_ERP_WAREHOUSE_USERNAME=demo_warehouse
ERPQA_MOCK_ERP_WAREHOUSE_PASSWORD=demo_only_5
# Optional AI test-IDEA generation. OpenAI only when explicitly selected in dashboard.
OPENAI_API_KEY=
ERPQA_OPENAI_MODEL=gpt-5.5
ERPQA_OLLAMA_MODEL=llama3.2

# v6.2.8 AI script testcase proposals
SMART_ERP_OPENAI_MODEL=gpt-4o-mini
SMART_ERP_OLLAMA_MODEL=llama3.2
# Docker: SMART_ERP_OLLAMA_URL is supplied by compose

# Leocem one-click role passwords come from the user's own script login() function.
# Do not add ERPQA_KAGAMI_DMG* password values here for that script.

# v6.3.2: Leocem URL and environment are still required for safe one-click execution.
# Enter the authorized TEST or STAGING URL for /leocem; do not enter production.
ERPQA_LEOCEM_TEST_URL=
ERPQA_LEOCEM_ENVIRONMENT=test
