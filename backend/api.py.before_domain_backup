from backend import leocem_quickrun as leocem

class LeocemLaunch(BaseModel):
    reviewed_sha256: str = Field(pattern=r'^[a-f0-9]{64}$')
    acknowledge_test_transactions: bool = False
    acknowledge_trusted_code: bool = False
    positive_scenarios: bool = True
    negative_scenarios: bool = False

@app.get('/api/leocem/ready')
def leocem_ready():
    return leocem.readiness()

@app.post('/api/leocem/run')
def leocem_run(body: LeocemLaunch):
    try:
        if body.positive_scenarios == body.negative_scenarios:
            raise ValueError('Choose exactly one scenario: Positive OR Negative.')
        if not body.acknowledge_test_transactions or not body.acknowledge_trusted_code:
            raise ValueError('Confirm the source code and authorized TEST/STAGING transactions before running.')
        status = leocem.readiness()
        if not status['ready']:
            raise ValueError('Leocem is not ready: ' + ' '.join(status['issues']))
        if status['script']['sha256'] != body.reviewed_sha256:
            raise ValueError('Your VS Code file changed. Review the newly saved revision before running.')
        project = leocem.ensure_project(status)
        run_input = sw.ScriptRunInput(project_id=project['id'], script_id=leocem.SCRIPT_ID,
            reviewed_sha256=body.reviewed_sha256, mode='new', trust_local_code=True,
            allow_test_transactions=True, initial_role_confirmed=False,
            positive_scenarios=body.positive_scenarios, negative_scenarios=body.negative_scenarios)
        return script_manager.start(run_input, controller)
    except Exception as err:
        fail(err)

