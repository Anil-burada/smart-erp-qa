@app.put('/api/workflows/{project_id}/{name}')
def workflow_update(project_id:str, name:str, updated: Workflow):
    original = load_workflow(project_id,name)
    if updated.project_id != project_id or updated.name != name:
        raise HTTPException(400, 'Cannot change workflow identity')
    if updated.start_url != original.start_url:
        raise HTTPException(400, 'Cannot change the start URL using editor')
    # Approved workflows must be reviewed again after any modification.
    updated.reviewed = False
    path = workflow_path(project_id,name)
    if updated.schema_version == 2:
        updated.locator_fingerprint=fingerprint(updated,read_library(project_id))
    atomic_json(path,updated.model_dump_json(indent=2))
    with connect() as c:
        c.execute('UPDATE workflows SET reviewed=0,step_count=?,updated_at=CURRENT_TIMESTAMP WHERE project_id=? AND name=?',(len(updated.steps),project_id,name))
    return updated


@app.post('/api/workflows/{project_id}/{name}/approve')
def approve_workflow(project_id:str, name:str):
    data = load_workflow(project_id,name)
    if not data.steps:
        raise HTTPException(400,'Cannot approve an empty workflow')
    if data.schema_version == 2:
        lib=read_library(project_id)
        if data.locator_fingerprint != fingerprint(data,lib):
            raise HTTPException(400,'Locator mappings changed; re-save workflow after review')
    if any(s.observed_count != 1 for s in data.steps):
        raise HTTPException(400,'Some steps were not uniquely observed. Edit/re-record and verify the locator before approval')
    data.reviewed = True
    atomic_json(workflow_path(project_id,name),data.model_dump_json(indent=2))
    with connect() as c:
        c.execute('UPDATE workflows SET reviewed=1, updated_at=CURRENT_TIMESTAMP WHERE project_id=? AND name=?',(project_id,name))
    return {'reviewed':True,'step_count':len(data.steps),'note':'Playwright revalidates uniqueness at replay time'}


