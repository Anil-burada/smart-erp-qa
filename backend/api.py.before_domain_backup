@app.post('/api/recorder/stop')
def recorder_stop(data: RecordInput):
    if not WORKFLOW_PATTERN.fullmatch(data.name):
        raise HTTPException(400, 'Workflow name must use lowercase letters, digits, underscores or hyphens')
    try:
        current = controller.call('status')
        if not (current.get('recording') or current.get('paused')) or not current.get('project_id'):
            raise ValueError('Recording has not been started')
        path = workflow_path(current['project_id'], data.name)
        if path.exists():
            raise ValueError('Workflow already exists. Choose a new name; existing workflows are not overwritten')
        stopped = controller.call('stop')
        if not stopped['steps']:
            raise ValueError('No supported steps captured. Retry with a short demo workflow')
        draft, library = convert_recording(stopped['project_id'], data.name, stopped['start_url'], stopped['steps'])
        # Existing locator keys are never overwritten; save both project-scoped files.
        save_library(library)
        atomic_json(path,draft.model_dump_json(indent=2))
        # Save a separate, unapproved draft of browser-native negative cases.
        proposed = generate_candidates(draft, library)
        negative_path = path.with_suffix('.negative_cases.json')
        atomic_json(negative_path, json.dumps({
            'project_id': draft.project_id, 'workflow': draft.name,
            'source': 'recorded_html_constraints', 'reviewed': False,
            'cases': proposed,
            'note': 'Candidate input constraints, NOT verified ERP business rules'
        }, indent=2))
        with connect() as c:
            c.execute('INSERT INTO workflows (project_id,name,reviewed,step_count) VALUES(?,?,0,?)', (draft.project_id,draft.name,len(draft.steps)))
        return {'workflow': draft.model_dump(), 'warnings': stopped['warnings'], 'negative_candidates':len(proposed)}
    except Exception as err:
        fail(err)


