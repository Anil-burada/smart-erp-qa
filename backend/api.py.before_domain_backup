@app.post('/api/suite/run')
def suite_execute(body:suite.RunSuiteInput):
    if not suite.SUITE_LOCK.acquire(blocking=False):
        raise HTTPException(409,'Another module-suite run is in progress')
    run_id=None
    try:
        chosen=suite.plan_cases(body)
        current=controller.call('status')
        if not current.get('open') or current.get('project_id')!=body.project_id:
            raise ValueError('Open this ERP from the dashboard and log in before running; your session will be reused')
        if current.get('recording') or current.get('paused'):
            raise ValueError('Finish the recording before running test cases')
        project=get_project(body.project_id)
        if project['environment']=='production':raise ValueError('Automation is disabled for production environments')
        if body.allow_test_transactions and project['environment'] not in ('test','staging'):
            raise ValueError('Transactions are restricted to TEST/STAGING')
        # Fail before run if ANY mapping has no reviewed workflow, and capture updated locator approvals.
        prepared=[]
        for item in chosen:
            wf=load_workflow(body.project_id,item['workflow_name'])
            if not wf.reviewed:raise ValueError(f'{item["testcase_id"]}: workflow is not reviewed')
            library=read_library(body.project_id) if wf.schema_version==2 else LocatorLibrary(project_id=body.project_id)
            if wf.schema_version==2 and wf.locator_fingerprint!=fingerprint(wf,library):
                raise ValueError(f'{item["testcase_id"]}: reviewed locator library changed; reapprove workflow')
            no_login,skipped=planned_existing_session_workflow(wf,library)
            executable=resolve_locators(no_login,library,{})
            executable['reuse_existing_login']=True
            executable['skipped_initial_login_steps']=skipped
            for number,step in enumerate(executable['steps'],start=skipped+1):
                step['original_step_number']=number
            prepared.append((item,executable))
        run_id=suite.create_run(body)
        for item,executable in prepared:
            # Excel does not contain executable test data or reliable role switching.
            # Negative, boundary and role cases need dedicated verified adapters.
            if item['polarity']=='Negative' or item['category'] in ('Boundary','Role-based'):
                report={'project_id':body.project_id,'workflow':item['workflow_name'],'status':'BLOCKED',
                    'message':'Requires an approved scenario-specific test data/assertion adapter; a happy-path workflow cannot verify this case.'}
            elif not any(s['action'].startswith('assert_') for s in executable['steps']):
                report={'project_id':body.project_id,'workflow':item['workflow_name'],'status':'BLOCKED',
                    'message':'Workflow has no executable assertion. Completed clicks alone cannot produce a Pass.'}
            else:
                try:
                    # Worker verifies ERP/URL/browser session again and captures failure evidence.
                    report=controller.call('run',workflow=executable,allow_writes=body.allow_test_transactions,allow_nav_repair=False)
                except Exception as err:
                    try:
                        evidence=controller.call('capture_failure',testcase_id=item['testcase_id'])
                    except Exception:
                        evidence={'screenshot':None}
                    report={'project_id':body.project_id,'workflow':item['workflow_name'],
                        'status':'FAILED','message':f'{type(err).__name__}: {str(err)[:500]}',
                        'screenshot':evidence.get('screenshot')}
                if report['status'] in ('PASSED','FAILED'):
                    save_execution(report,body.project_id,item['workflow_name'])
            suite.save_case_result(run_id,body.project_id,item,report)
        results=suite.batch_results(run_id)
        statuses=[r['status'] for r in results]
        status='FAILED' if 'FAILED' in statuses else 'PARTIAL' if 'BLOCKED' in statuses else 'PASSED'
        suite.complete_run(run_id,status)
        return {'run_id':run_id,'status':status,'total':len(results),
                'passed':statuses.count('PASSED'),'failed':statuses.count('FAILED'),
                'blocked':statuses.count('BLOCKED'),'results':results,
                'note':'Browser remained open and authenticated. No automatic login or page reload was performed.'}
    except HTTPException:
        if run_id:suite.complete_run(run_id,'FAILED')
        raise
    except Exception as err:
        if run_id:suite.complete_run(run_id,'FAILED')
        fail(err)
    finally:
        suite.SUITE_LOCK.release()


@app.get('/api/suite/evidence/{result_id}/{artifact_kind}')
