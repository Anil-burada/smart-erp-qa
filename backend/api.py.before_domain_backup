def delete_project(project_id: str):
    if not get_project(project_id):
        raise HTTPException(404, 'Project not found')
    try:
        session = controller.call('status')
        if session.get('project_id') == project_id:
            raise ValueError('Close the browser before deleting this project')
        with connect() as c:
            if c.execute('SELECT COUNT(*) FROM workflows WHERE project_id=?',(project_id,)).fetchone()[0]:
