def load_workflow(project_id, name):
    if not get_project(project_id):
        raise HTTPException(404, 'Project not found')
    try:
        path = workflow_path(project_id, name)
        if not path.exists():
            raise HTTPException(404,'Workflow not found')
        result = Workflow.model_validate_json(path.read_text(encoding='utf-8'))
        if result.project_id != project_id or result.name != name:
            raise ValueError('Workflow belongs to a different project/name')
        return result
    except HTTPException:
        raise
    except Exception as err:
        fail(err)


