    try:
        library = read_library(data.project_id) if workflow.schema_version == 2 else LocatorLibrary(project_id=data.project_id)
        # Run From Login already authenticates. Do not replay an old leading
        # username/password/Sign In sequence a second time after verification.
        prepared, skipped = planned_existing_session_workflow(workflow, library)
        executable = resolve_locators(prepared, library, data.test_data)
        executable['skipped_initial_login_steps'] = skipped
        for idx, step in enumerate(executable['steps'], start=skipped + 1):
            step['original_step_number'] = idx
        config = load_login_config(data.project_id)
        controller.call('open', project=project, embedded=data.embedded)
        try:
            controller.call('login',
                config=config.model_dump(exclude={'schema_version','project_id','project_url'}),
                username=data.username,
                password=data.password.get_secret_value()
            )
        except Exception:
            # Preserve only a generic message, not any Playwright/credential detail.
            report = {
                'project_id': data.project_id,
                'workflow': data.name,
                'status': 'FAILED',
                'completed_steps': 0,
