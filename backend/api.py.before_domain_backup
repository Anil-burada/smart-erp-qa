def fail(err: Exception):
    if isinstance(err, ValueError):
        raise HTTPException(400, str(err)) from err
    if isinstance(err, TimeoutError):
        raise HTTPException(504, str(err)) from err
    # User-visible error text is truncated and never includes login data.
    raise HTTPException(500, f'{type(err).__name__}: {str(err)[:500]}') from err


