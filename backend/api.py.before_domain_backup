        report = controller.call('run', workflow=executable, allow_writes=data.allow_test_transactions,
                                 allow_nav_repair=data.allow_nav_repair)
        report['login_verified'] = True
        report['run_mode'] = 'inside_dashboard' if data.embedded else 'new_browser'
