@app.post('/api/pom/linked/run')
def pom_linked_run(plan: LinkedPlan):
    """Run reviewed POM stages in order in the SAME authorized browser role.

    Captures actual IDs from explicit `capture_*` steps; on any failed stage
    stops and marks downstream stages BLOCKED. Never auto-retries writes.
    """
    try:
        check=inspect_plan(plan)  # Entire dependency preflight BEFORE first action.
        status=controller.call('status')
        if status.get('project_id') != plan.project_id or not status.get('open'):
            raise ValueError('Open and authenticate the matching ERP in a Playwright browser first')
        context={}
        reports=[]
        blocked=False
        for stage in plan.stages:
            if blocked:
                reports.append({'workflow':stage.template,'status':'BLOCKED','reason':'Earlier dependent workflow failed'})
                continue
            spec=compile_pom(plan.project_id,stage.template,plan.test_data,context)
            report=controller.call('run',workflow=spec,allow_writes=True)
            save_execution(report)
            reports.append(report)
            if report['status']=='PASSED':
                context.update(report.get('outputs',{}))
            else:
                blocked=True
        return {'project_id':plan.project_id,'status':'FAILED' if blocked else 'PASSED',
                'stages':reports,'captured_context':context,
                'note':'Only the configured same-role stages were executed. High-impact role transitions are not automatic.'}
    except Exception as err:
        fail(err)

@app.get('/api/workflows/{project_id}/{name}/step-review/{step_number}/candidates')
def candidate_locators(project_id: str, name: str, step_number: int):
    """Offer only locators that Playwright confirms are uniquely visible.

    Candidate discovery is deterministic; local AI diagnosis remains optional.
    No locator is changed, approved or clicked by this endpoint.
    """
    wf=load_workflow(project_id,name)
    if not 1 <= step_number <= len(wf.steps):
        raise HTTPException(404, 'Invalid step number')
    if controller.call('status').get('project_id') != project_id:
        raise HTTPException(400, 'Open the correct ERP browser first')
    step=wf.steps[step_number-1]
    matches=[]
    for candidate in step.observed_candidates[:8]:
        raw=candidate.get('spec') if isinstance(candidate,dict) else None
        if not raw:
            continue
        try:
            info=controller.call('test_locator',spec=LocatorSpec.model_validate(raw).model_dump(exclude_none=True))
            matches.append({'locator':raw,'count':info['count'],'visible':info['visible'],
                            'usable_candidate':info['count']==1 and info['visible']})
        except Exception:
            matches.append({'locator':raw,'count':0,'visible':False,'usable_candidate':False})
    return {'step_number':step_number,'candidates':matches,
            'note':'Potential alternatives only. Review semantic target, edit locator library, then verify the step. No automatic repair.'}

