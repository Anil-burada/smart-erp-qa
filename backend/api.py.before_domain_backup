@app.put('/api/projects/{project_id}/locators')
def locator_library_update(project_id: str, updated: LocatorLibrary):
    if updated.project_id != project_id:
        raise HTTPException(400,'Project locator library identity mismatch')
    try:
        previous=read_library(project_id)
        if previous.model_dump() != updated.model_dump():
            # Reject removal of a field still used by a saved workflow.
            with connect() as c:
                rows=c.execute('SELECT name FROM workflows WHERE project_id=?',(project_id,)).fetchall()
            workflows_v2=[]
            for row in rows:
                stored=load_workflow(project_id,row['name'])
                if stored.schema_version==2:
                    fingerprint(stored,updated)
                    workflows_v2.append(stored)
            save_library(updated)
            # Reset approvals of workflows referring to edited locators.
            for stored in workflows_v2:
                if fingerprint(stored,previous)!=fingerprint(stored,updated):
                    stored.reviewed=False
                    atomic_json(workflow_path(project_id,stored.name),stored.model_dump_json(indent=2))
                    with connect() as c:
                        c.execute('UPDATE workflows SET reviewed=0 WHERE project_id=? AND name=?',(project_id,stored.name))
        return updated
    except Exception as err:
        fail(err)


@app.post('/api/workflows/{project_id}/{name}/convert-v2')
def convert_v1_workflow(project_id: str, name: str):
    existing=load_workflow(project_id,name)
    if existing.schema_version!=1:
        raise HTTPException(400,'Workflow is already JSON-driven v2')
    try:
        steps=[s.model_dump(exclude={'target'},exclude_none=True) for s in existing.steps]
        updated, library=convert_recording(project_id,name,existing.start_url,steps)
        path=workflow_path(project_id,name)
        backup=path.with_suffix('.v1-backup.json')
        if backup.exists():
            raise ValueError('Legacy backup already exists; manual review required')
        # Keep original workflow before converting; the backup is not loaded by the UI.
        atomic_json(backup,path.read_text(encoding='utf-8'))
        save_library(library)
        atomic_json(path,updated.model_dump_json(indent=2))
        with connect() as c:
            c.execute('UPDATE workflows SET reviewed=0 WHERE project_id=? AND name=?',(project_id,name))
        return updated
    except Exception as err:
        fail(err)


