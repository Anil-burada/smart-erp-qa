@app.middleware('http')
async def local_only(request: Request, call_next):
    # SMART_ERP_PROTECTED_REMOTE_HOST_V636_20261029:
    # This is opt-in and intended ONLY behind Cloudflare email-protected Tunnel.
    host = (request.headers.get('host') or '').lower().split(':')[0]
    origin = request.headers.get('origin')
    local_host = host in ('127.0.0.1', 'localhost')
    remote_host = (os.environ.get('SMART_ERP_ALLOWED_REMOTE_HOST') or '').strip().lower()
    remote_enabled = os.environ.get('SMART_ERP_ENABLE_PROTECTED_REMOTE') == '1'
    remote_host_valid = bool(remote_host) and remote_host.endswith('.trycloudflare.com') and remote_host.count('.') >= 2
    remote_request = bool(remote_enabled and remote_host_valid and host == remote_host)
    # Origin is still loopback-only. A localhost tunnel connector can reach it;
    # we do not open the web server on the machine's network interfaces.
    client_host = request.client.host if request.client else None
    if remote_request and client_host not in ('127.0.0.1', '::1'):
        return JSONResponse({'detail': 'Remote connector must be local'}, status_code=403)
    if not local_host and not remote_request:
        return JSONResponse({'detail': 'Localhost only'}, status_code=403)
    if origin:
        parsed = urlsplit(origin)
        local_origin = parsed.scheme == 'http' and parsed.hostname in ('127.0.0.1', 'localhost') and parsed.port == 8766
        remote_origin = remote_request and parsed.scheme == 'https' and parsed.hostname == remote_host and parsed.port is None
        if not local_origin and not remote_origin:
            return JSONResponse({'detail': 'Cross-origin request denied'}, status_code=403)
    # Keep one owner of the managed page while a trusted script is executing.
    # Read-only status/evidence APIs remain usable. Stop is always available.
    if script_manager.busy and request.method not in ('GET', 'HEAD', 'OPTIONS'):
        if not request.url.path.startswith('/api/script-workspace/'):
            return JSONResponse({'detail': 'Script is running. Stop it before modifying the workspace or browser.'}, status_code=409)
    return await call_next(request)


