@app.post('/api/workflows/{project_id}/{name}/step-review/{step_number}/verify')
def verify_recorded_step(project_id: str, name: str, step_number: int, request: StepReviewRequest):
    if not request.confirm_intended_element:
        raise HTTPException(400, 'Confirm you inspected the correct target element before verifying')
    workflow = load_workflow(project_id,name)
    if not 1 <= step_number <= len(workflow.steps):
        raise HTTPException(404, 'Invalid step number')
    status = controller.call('status')
    if status.get('project_id') != project_id:
        raise HTTPException(400,'Open the same registered ERP before verifying this step')
    step = workflow.steps[step_number-1]
    # Critical: test in the page context in which the step was originally observed.
    if step.page_url and (status.get('url') or '').rstrip('/') != step.page_url.rstrip('/'):
        raise HTTPException(400, 'Navigate to the recorded step page before verification; current URL differs')
    try:
        if workflow.schema_version == 2:
            lib=read_library(project_id)
            field=lib.fields[step.target]
            loc=field.locator.model_dump(exclude_none=True)
        else:
            loc=step.locator.model_dump(exclude_none=True)
        result=controller.call('test_locator',spec=loc)
        if result['count'] != 1 or not result['visible']:
            raise ValueError('Locator is not uniquely visible on this page')
        # Testing uniqueness is not proof of correct semantics: the user confirms intent.
        step.observed_count=1
        workflow.reviewed=False
        if workflow.schema_version==2:
            field.observed_count=1
            save_library(lib)
            workflow.locator_fingerprint=fingerprint(workflow,lib)
        atomic_json(workflow_path(project_id,name),workflow.model_dump_json(indent=2))
        with connect() as c:
            c.execute('UPDATE workflows SET reviewed=0,updated_at=CURRENT_TIMESTAMP WHERE project_id=? AND name=?',(project_id,name))
        return {'verified_unique':True,'step_number':step_number,'count':1,
                'note':'Review remaining steps before approving. No click or submit was performed.'}
    except Exception as err:
        fail(err)


