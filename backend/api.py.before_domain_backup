@app.get('/api/workflows/{project_id}/{name}/preflight-first')
def preflight_first(project_id: str, name: str, reuse_existing_login: bool = False):
    """Diagnose the first locator and the current browser screen without touching the ERP."""
    try:
        original = load_workflow(project_id, name)
        library = read_library(project_id) if original.schema_version == 2 else LocatorLibrary(project_id=project_id)
        workflow, skipped = (planned_existing_session_workflow(original, library)
                             if reuse_existing_login else (original, 0))
        if not workflow.steps:
            raise ValueError('This workflow has no executable business actions')
        first = workflow.steps[0]
        if workflow.schema_version == 2:
            if not first.target or first.target not in library.fields:
                raise ValueError('First-step locator target is missing from the project locator library')
            spec = library.fields[first.target].locator.model_dump(exclude_none=True)
            current_review = workflow.reviewed and workflow.locator_fingerprint == fingerprint(workflow, library)
        else:
            spec = first.locator.model_dump(exclude_none=True)
            current_review = workflow.reviewed
        diagnosis = controller.call('preflight_first',project_id=project_id,workflow_name=name,
                                    first_step={'locator':spec,'action':first.action,'target_text':first.target_text,
                                                'observed_candidates':first.observed_candidates},
                                    start_url=first.page_url or workflow.start_url,reviewed=current_review)
        diagnosis['skipped_initial_login_steps'] = skipped
        diagnosis['first_executable_step_number'] = skipped + 1
        diagnosis['session_mode'] = 'reuse_existing_login' if reuse_existing_login else 'standard'
        return diagnosis
    except Exception as err:
        fail(err)


